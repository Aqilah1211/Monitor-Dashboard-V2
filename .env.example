# IFP Dashboard - Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================
# Google Sheets Configuration
# ============================================
# Google Sheets CSV Export URL
# Format: https://docs.google.com/spreadsheets/d/{SHEET_ID}/export?format=csv&gid={SHEET_GID}
VITE_GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/export?format=csv&gid=0

# Optional: Google Sheets API Key (for future API integration)
VITE_GOOGLE_API_KEY=

# ============================================
# Application Settings
# ============================================
# Application environment: development, staging, production
VITE_APP_ENV=development

# Application name
VITE_APP_NAME=IFP Dashboard

# Application version
VITE_APP_VERSION=2.0.0

# ============================================
# API Configuration
# ============================================
# Backend API base URL (if applicable)
VITE_API_URL=http://localhost:3000/api

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# ============================================
# Feature Flags
# ============================================
# Enable debug mode (logs to console and localStorage)
VITE_DEBUG_MODE=true

# Enable analytics/tracking
VITE_ENABLE_ANALYTICS=false

# Enable data export feature
VITE_ENABLE_EXPORT=true

# ============================================
# Data Settings
# ============================================
# Default pagination page size
VITE_DEFAULT_PAGE_SIZE=50

# Search debounce delay in milliseconds
VITE_SEARCH_DEBOUNCE=300

# Google Sheets refresh interval in milliseconds (30 minutes)
VITE_REFRESH_INTERVAL=1800000

# ============================================
# UI/UX Settings
# ============================================
# Enable dark mode
VITE_DARK_MODE=false

# Language: id (Indonesian) or en (English)
VITE_LANGUAGE=id

# ============================================
# Development Settings
# ============================================
# Vite dev server port
VITE_DEV_PORT=5173

# Enable React DevTools
VITE_REACT_DEVTOOLS=true

# ============================================
# Deployment Settings
# ============================================
# Vercel deployment URL
VITE_VERCEL_URL=https://your-deployment.vercel.app

# Production domain
VITE_PRODUCTION_URL=https://ifp-dashboard.example.com

# ============================================
# Monitor/Logging
# ============================================
# Log level: error, warn, info, debug, trace
VITE_LOG_LEVEL=info

# Enable request logging
VITE_LOG_REQUESTS=true

# Enable error reporting (e.g., to Sentry)
VITE_ERROR_REPORTING=false

# Error reporting endpoint
VITE_ERROR_REPORTING_URL=

# ============================================
# Security
# ============================================
# CORS allowed origins (comma-separated)
VITE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Content Security Policy enabled
VITE_CSP_ENABLED=true
