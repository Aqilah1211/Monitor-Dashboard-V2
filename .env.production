# IFP Dashboard - Production Environment
# Copy to .env.production for production deployment
# Use secure values for all secrets from environment variables

# ============================================
# Google Sheets Configuration (REQUIRED)
# ============================================
# Production Google Sheets URL
# Should point to the production data source
VITE_GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/1E4UBDg9M0RKTvtJCXUOg4IWQmvl1mdmIqeN9CyRw5qs/export?format=csv&gid=0

# ============================================
# Application Settings
# ============================================
VITE_APP_ENV=production
VITE_APP_NAME=IFP Dashboard
VITE_APP_VERSION=2.0.0

# ============================================
# API Configuration
# ============================================
# Production API endpoint
VITE_API_URL=https://api.ifp-dashboard.com/api
VITE_API_TIMEOUT=30000

# ============================================
# Feature Flags (Production)
# ============================================
# Disable debug mode in production
VITE_DEBUG_MODE=false

# Enable analytics in production
VITE_ENABLE_ANALYTICS=true

# Enable export feature
VITE_ENABLE_EXPORT=true

# ============================================
# Data Settings (Production)
# ============================================
# Default pagination size
VITE_DEFAULT_PAGE_SIZE=50

# Search debounce (300ms)
VITE_SEARCH_DEBOUNCE=300

# Google Sheets refresh interval (30 minutes = 1800000ms)
# Higher interval in production to reduce API calls
VITE_REFRESH_INTERVAL=1800000

# ============================================
# UI/UX Settings (Production)
# ============================================
VITE_DARK_MODE=false
VITE_LANGUAGE=id

# ============================================
# Deployment Settings (Production)
# ============================================
# Production URL (set by Vercel or your hosting)
VITE_VERCEL_URL=https://ifp-dashboard.vercel.app
VITE_PRODUCTION_URL=https://ifp-dashboard.com

# ============================================
# Monitor/Logging (Production)
# ============================================
# Log level in production (warn or error only)
VITE_LOG_LEVEL=warn

# Do not log requests in production
VITE_LOG_REQUESTS=false

# Enable error reporting in production
VITE_ERROR_REPORTING=true

# Error reporting service endpoint (e.g., Sentry)
VITE_ERROR_REPORTING_URL=https://sentry.io/your-project-id

# ============================================
# Security (Production)
# ============================================
# Production domain only
VITE_CORS_ORIGINS=https://ifp-dashboard.com,https://www.ifp-dashboard.com

# Enable Content Security Policy
VITE_CSP_ENABLED=true
