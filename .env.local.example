# IFP Dashboard - Local Development Environment
# Copy this file to .env.local and customize for your local setup
# Do NOT commit .env.local to git (it's in .gitignore)

# ============================================
# Google Sheets Configuration (REQUIRED)
# ============================================
# Get this URL from your Google Sheet:
# 1. Open your Google Sheet
# 2. Click Share button (top right)
# 3. Change to "Viewer" (read-only) access
# 4. Click File → Share → Publish to web
# 5. Select CSV format
# 6. Copy the URL
VITE_GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/1234567890abcdefghijklmnopqrstuvwxyz/export?format=csv&gid=0

# ============================================
# Application Settings
# ============================================
VITE_APP_ENV=development
VITE_APP_NAME=IFP Dashboard
VITE_APP_VERSION=2.0.0

# ============================================
# API Configuration
# ============================================
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# ============================================
# Feature Flags (Development)
# ============================================
# Enable detailed debug logging to console
VITE_DEBUG_MODE=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_EXPORT=true

# ============================================
# Data Settings
# ============================================
# Pagination page size
VITE_DEFAULT_PAGE_SIZE=50

# Search debounce delay (300ms = good balance between responsiveness and performance)
VITE_SEARCH_DEBOUNCE=300

# Google Sheets refresh interval (30 minutes = 1800000ms)
# For development, reduce to 5 minutes (300000ms) for faster testing
VITE_REFRESH_INTERVAL=300000

# ============================================
# UI/UX Settings
# ============================================
VITE_DARK_MODE=false
VITE_LANGUAGE=id

# ============================================
# Development Settings
# ============================================
# Vite dev server port (default 5173)
VITE_DEV_PORT=5173

# Enable React DevTools integration
VITE_REACT_DEVTOOLS=true

# ============================================
# Deployment Settings (Local)
# ============================================
VITE_VERCEL_URL=http://localhost:5173
VITE_PRODUCTION_URL=http://localhost:5173

# ============================================
# Monitor/Logging (Development)
# ============================================
# Log level: error, warn, info, debug, trace
VITE_LOG_LEVEL=debug

# Log API requests for debugging
VITE_LOG_REQUESTS=true

# Skip error reporting in development
VITE_ERROR_REPORTING=false

# ============================================
# Security (Development)
# ============================================
# Localhost only for development
VITE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# CSP enabled even in development
VITE_CSP_ENABLED=true
